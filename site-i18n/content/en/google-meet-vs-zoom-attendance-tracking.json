    {
      "id": "f9058c5c82",
      "kind": "head",
      "key": "meta[property=\"og:description\"]",
      "text": "Migrating from Zoom to Google Meet? Here is how to get Zoom-style attendance reports in Google Meet without paying for Education Plus."
    },
