      "text": "Documenting meeting attendance for badge requirements and volunteer ranks."
    },
    {
      "id": "c16773272c",
      "kind": "html",
      "key": "td",
      "text": "<strong>Rotary, Lions &amp; Kiwanis Clubs</strong>"
    },
    {
      "id": "295ca4a89f",
