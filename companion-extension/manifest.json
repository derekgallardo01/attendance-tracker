{
  "manifest_version": 3,
  "name": "Attendance Tracker for Google Meet — Launcher",
  "short_name": "Attendance Tracker",
  "version": "1.0.0",
  "description": "Companion launcher for Attendance Tracker in Google Meet. Real-time roll call, timestamps, and one-click Sheets export.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Attendance Tracker for Google Meet"
  },
  "icons": {
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
